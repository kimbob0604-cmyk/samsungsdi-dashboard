 H+=`<section class="page" id="val"><div class="page-head"><h1>밸류에이션</h1><p>컨센서스 2028E 지배순이익 × PER = 시총 · AMPC는 컨센 이익에 포함 · 전고체 0</p></div>
 <div class="kpis">${kpi('지금 시총',fz(MC),'2028E PER 15.4배','val')}${kpi('목표 시총',fz(SC.tgt),fa(add(SC.tgt))+' · 2028E 순이익 × 24배','val')}${kpi('하방 시총',fz(SC.down),fa(add(SC.down))+' · PBR 1.0배','val')}${kpi('위아래 비율',nf(add(SC.tgt)/-add(SC.down),1)+' : 1','목표 애드 ÷ 하방','val')}</div>
 <div class="two">${card('시나리오별 시총 (조원)','',`<div class="ch-box tall"><canvas id="cV"></canvas></div>`)}
 ${card('표','',`<div class="tw"><table><thead><tr><th>시나리오</th><th>가정</th><th class="n">시총</th><th class="n">시총 애드</th></tr></thead><tbody>${rows.map(r=>`<tr${r[0]==='목표'?' style="font-weight:700"':''}><td>${r[0]}</td><td>${r[1]}</td><td class="n">${fz(r[2])}</td><td class="n ${cls(add(r[2]))}">${fa(add(r[2]))}</td></tr>`).join('')}</tbody></table></div>
 <ul class="def" style="margin-top:10px"><li><b>이익:</b> 증권사 5곳 평균 2028E 지배순이익 2.35조(교보 2.02 · 하나 2.26 · 대신 2.76). AMPC가 영업이익의 대부분인 이익</li><li><b>왜 2028년:</b> 미국 LFP 라인이 2027년에 깔리고 2028년에 온전히 돌아가는 해. 2027E PER 26배는 바닥 이익이라 의미가 약함</li><li><b>왜 24배:</b> 하나증권 24MF 평균 PER. 배수를 올리지 않음. 20배여도 +10.8조</li><li><b>교차 확인:</b> 최근 6개월 증권사 평균 목표가 76.5만원 = 시총 ${fz(SC.avg6)}. 내 목표는 그보다 낮음</li></ul>`)}</div>
 ${card('직접 계산','',`<div class="fin-in"><label>2028E 지배순이익(조)<input type="number" id="vN" value="2.35" step="0.05"></label><label>PER(배)<input type="number" id="vP" value="24" step="1"></label></div><div>시총 <span class="big" id="vOut"></span> <span id="vUp"></span></div>`)}
 </section>`;
 /* 주가 */
 H+=`<section class="page" id="px"><div class="page-head"><h1>주가·피어</h1><p>최근 1년 일봉 · Yahoo Finance(11/24)</p></div>
 ${card('삼성SDI 종가','1년 전 302,000원 → 1월 저점 262,500원 → 4월 고점 712,000원(종가) → 11/24 449,500원(당일 +13.5%, 원인 미확인) · 연 변동성 78%',`<div class="ch-box tall"><canvas id="cP"></canvas></div>`)}
 ${card('상대 수익률 (1년 전 = 100)','셀·소재 피어',`<div class="ch-box"><canvas id="cR"></canvas></div>`)}
 ${card('피어 비교','Yahoo Finance 11/24 · 매출 성장·영업이익률은 최근 분기/4분기 기준, 통화는 각국',`<div class="tw"><table><thead><tr><th>회사</th><th class="n">시총</th><th class="n">선행 PER</th><th class="n">EV/EBITDA</th><th class="n">매출 성장</th><th class="n">영업이익률</th><th class="n">1년 주가</th></tr></thead><tbody>${PEERS.map(p=>{const u=p.cur==='KRW'?nf(p.mc/1e12,1)+'조원':p.cur==='CNY'?nf(p.mc/1e9)+'억위안'.replace('억','0억'):nf(p.mc/1e12,1)+'조엔';return `<tr${p.n==='삼성SDI'?' style="font-weight:700"':''}><td>${p.n}</td><td class="n">${p.cur==='CNY'?nf(p.mc/1e8)+'억위안':u}</td><td class="n">${nf(p.fpe,1)}배</td><td class="n">${p.eve?nf(p.eve,1)+'배':'-'}</td><td class="n ${cls(p.rg)}">${pc(p.rg*100)}</td><td class="n">${pc(p.opm*100,1)}</td><td class="n ${cls(p.y52)}">${pc(p.y52*100)}</td></tr>`}).join('')}</tbody></table></div>
 <ul class="def" style="margin-top:10px"><li>LGES 선행 PER 45배 vs SDI 25배. 같은 미국 ESS 이야기인데 SDI가 더 쌈</li><li>펌텍코리아와 1년 일간 수익률 상관계수 0.21 → 두 종목을 같이 들 때 분산 효과</li></ul>`)}
 </section>`;
 /* 피칭 */
 H+=`<section class="page" id="pitch"><div class="page-head"><h1>5분 피칭</h1><p>지금 봐야 하는 이유 → 산업의 변화 → 투자포인트 1·2·3 → 밸류 → 언제 사고 언제 파나 · 금액은 시총 기준</p></div>
 ${card('연결 멘트 (펌텍 → 삼성SDI, 약 20초)','',`<div class="script"><p>펌텍이 이미 숫자로 증명된 성장을 합리적인 가격에 사는 아이디어라면, 두 번째는 업황 바닥에서 이익 구조 자체가 바뀌는 대형 턴어라운드입니다. 하나는 K뷰티 소비, 하나는 AI 데이터센터 전력이라 두 종목의 1년 상관계수는 0.21에 그칩니다. 두 번째는 삼성SDI입니다.</p></div>`)}
 ${card('스크립트','',`<div class="script">
 <p><span class="tg">[0:00 지금 봐야 하는 이유]</span>두 번째 종목은 삼성SDI, 매수 의견입니다. 지금 봐야 하는 이유는 10월 미국 공장에서 ESS용 LFP 양산이 시작되면서, 미국 생산세액공제 AMPC가 이익으로 찍히기 시작했기 때문입니다. 3분기 AMPC는 1,225억원이었고, 4분기부터 미국 물량이 본격적으로 더해집니다. 그런데 주가는 4월 고점보다 약 37% 낮고, 컨센서스 2028년 순이익 기준 PER 15배입니다.</p>
 <p><span class="tg">[0:35 산업의 변화]</span>올해 상반기 북미 ESS 배터리 출하의 71%는 중국산이었습니다. 미국은 관세를 약 41%까지 올렸고, 세액공제를 받으려면 중국 소재를 쓰지 못하게 했습니다. 이 요건은 원산지가 아니라 소유·지배 기준이라 제3국 공장으로도 피할 수 없습니다. 8월에는 이미 설치된 중국산 ESS까지 막을 수 있는 행정명령도 나왔습니다. 중국이 빠지는 자리를 미국에 공장을 가진 한국 회사가 채웁니다.</p>
 <p><span class="tg">[1:15 투자포인트 1: AMPC가 이익이다]</span>미국에서 셀과 모듈을 만들면 kWh당 45달러, 1GWh당 약 630억원을 받습니다. 증권사들은 내년 AMPC를 1조 1천억원, 영업이익의 72%로 봅니다. 결국 이익은 미국에서 몇 GWh를 만드느냐로 정해집니다. 미국 ESS 생산능력은 내년 말 30GWh대, 2028년 50GWh로 늘어나고, 수주는 이미 60GWh를 넘어 2028년까지 물량을 확보했습니다.</p>
 <p><span class="tg">[2:00 투자포인트 2: 비중국 소재가 진입장벽]</span>AMPC를 받으려면 비중국 소재 비중이 내년 65%, 2029년 80%를 넘어야 합니다. 핵심은 셀 원재료비의 40%인 양극재인데, 삼성SDI는 엘앤에프와 1조 6천억원 규모의 LFP 양극재 계약을 먼저 맺었습니다. 고객도 미국산 한국 셀을 쓰면 프로젝트 비용이 kWh당 135달러로, 중국산 242달러보다 훨씬 쌉니다.</p>
 <p><span class="tg">[2:35 투자포인트 3: 데이터센터 백업전원]</span>리튬 UPS 배터리 시장 점유율이 약 50%이고, 재계약률이 90%를 넘습니다. 배터리를 바꾸려면 재인증에 넉 달이 걸려 한 번 들어가면 잘 바뀌지 않습니다. AI 데이터센터가 커질수록 ESS와 별개로 이익이 붙는 축입니다.</p>
 <p><span class="tg">[3:05 밸류에이션]</span>지금 시총은 36조원입니다. 컨센서스 2028년 순이익 2조 3,500억원에 과거 평균 PER 24배를 주면 56조원으로, 20조원이 더해집니다. 하방은 PBR 1배인 25조원으로 11조원 감소이고, 위아래 비율은 1.8 대 1입니다. 증권사 목표가가 60만~94만원으로 갈리는 건 배수가 아니라 미국 생산량 가정 차이라, 분기 AMPC로 바로 확인할 수 있습니다.</p>
 <p><span class="tg">[3:45 언제 사고 언제 파나]</span>변동성이 연 78%라 세 번에 나눠 사고, 급등한 날은 추격하지 않습니다. 하루 거래대금이 3,500억원이라 펀드 1%는 하루면 담깁니다. 볼 이벤트는 네 가지입니다. 12월 24일 전후 나올 에너지부 행정명령 세부 규칙, 1월 말 4분기 실적의 AMPC 약 2천억원, 1월에 끝나는 미중 무역 휴전, 그리고 내년 상반기 미국 라인 2개 추가 전환입니다. AMPC가 두 분기 연속 줄거나 소재 요건을 못 맞추면 팔고, 시총이 56조원에 가까워지면 2029년 이익을 다시 봅니다.</p></div>`)}
 ${card('외울 숫자','',`<ul class="def"><li>시총 36조 → 목표 56조(+20조) · 하방 25조(-11조) · 1.8 : 1</li><li>컨센 2028E 순이익 2.35조 × 24배 · 지금 15.4배 · 6개월 평균 목표가 76.5만원 = 시총 62조</li><li>AMPC kWh당 $45 · 1GWh당 630억 · 3Q26 1,225억 → 4Q26E 약 2,000억 → 2027E 1.1조(영업이익의 72%) · 2028E 1.4조(가장 보수적)</li><li>미국 ESS CAPA 2027말 30GWh대 → 2028 50GWh · 수주 60GWh+ · 2028년까지 물량 확보</li><li>북미 ESS 출하 중국 71%(1H26) · 관세 약 41% · 소재 요건 65%(2027) → 80%(2029) · 엘앤에프 양극재 1.6조</li><li>목표가 60만(흥국) ~ 94만(DS) · 배수 12~13배(EV/EBITDA) · UPS 점유율 50%</li><li>2025 "13.3조, -1.7조" · 3Q26 "4.7조 / 4,078억" · 거래대금 3,500억 · 변동성 78% · 펌텍 상관 0.21</li></ul>`)}
 </section>`;
 /* 질의 */
 const QA=[
 ['3분기 실적이 일회성 아닌가?','4,078억원 중 일회성 순이익 약 2천억원은 맞습니다. 하지만 AMPC 1,225억원은 미국 생산이 늘수록 커지는 이익이고, 증권사들은 4분기 약 2천억원, 내년 1조 1천억원으로 봅니다. 4분기 감익은 일회성 기저 때문이라 컨센서스에 이미 들어 있습니다.'],
 ['이익의 70%가 세액공제면 질이 낮은 것 아닌가?','AMPC는 법에 정해진 단가로, 미국에서 만든 만큼 현금으로 들어오는 이익입니다. 비중국 소재 요건 때문에 아무나 받지 못한다는 점에서 미국 현지 생산이라는 진입장벽의 대가로 봅니다. 다만 2030년부터 단가가 줄기 때문에 배수는 올리지 않고 과거 평균 24배만 썼습니다.'],
 ['AMPC가 없어지면?','현행 법에서 2029년까지 kWh당 45달러이고, 2030년부터 줄어 2033년에 끝납니다. 법이 바뀌는 것보다 현실적인 리스크는 소재 요건을 못 맞추는 경우입니다. 그래서 엘앤에프 양극재 계약과 분기 AMPC 금액을 확인합니다.'],
 ['AMPC를 고객에게 깎아 주지 않나?','일부는 판가 협상에 쓰일 수 있습니다. 하지만 중국 셀이 빠지는 시장에서 미국산 비중국 셀은 공급이 부족하고, 고객도 투자세액공제를 받으려면 비중국 셀이 필요합니다. 증권사들도 AMPC를 영업이익에 그대로 반영하고 있습니다.'],
 ['왜 PER 24배인가?','하나증권이 쓴 24개월 선행 평균 PER입니다. 배수를 올려 잡지 않았고, 20배만 적용해도 47조원으로 지금보다 11조원 높습니다. EV/EBITDA로 보는 증권사들은 12~13배를 쓰는데, 지금 주가는 2028년 EBITDA의 약 8배입니다.'],
 ['목표가가 60만원부터 94만원까지 왜 이렇게 갈리나?','배수보다 미국 생산량 가정 차이입니다. 최근 60만원으로 낮춘 흥국증권은 2028년 미국 출하를 23GWh, AMPC를 1조 4천억원으로 가장 보수적으로 봅니다. 1GWh가 AMPC 약 630억원이라, 분기 AMPC를 보면 어느 쪽이 맞는지 바로 확인할 수 있습니다.'],
 ['2027년 PER 26배는 비싸지 않나?','2027년은 이익이 바닥에서 올라오는 해라 배수가 높게 보입니다. 미국 라인이 온전히 돌아가는 2028년 기준으로는 15배입니다.'],
 ['LG에너지솔루션 대신 왜 SDI?','LGES는 미국 양산이 먼저고 공장 지분이 100%라 AMPC를 많이 받는 건 맞습니다. 그래도 같은 AMPC 수혜를 SDI는 선행 PER 25배, LGES는 45배에 거래합니다. 여기에 리튬 UPS 점유율 50%라는 축이 하나 더 있습니다.'],
 ['중국이 정말 빠지나?','관세는 약 41%이고, 세액공제 소재 요건은 소유·지배 기준이라 우회가 어렵습니다. 국방부는 CATL과의 거래를 2027년부터 금지했고, 8월에는 이미 설치된 장비까지 막을 수 있는 행정명령이 나왔습니다. 다음 달 에너지부 세부 규칙이 그 강도를 정합니다.'],
 ['유상증자 또 하나?','2025년 3월 보통주가 17% 늘었습니다. 올해는 증자 대신 삼성디스플레이 지분 5%를 4.45조원에 팔아 차입금 3.6조원을 갚았고, 부채비율은 78%에서 67%로 내려왔습니다. AMPC가 현금으로 들어오기 시작하면 증설 재원도 안에서 나옵니다.'],
 ['하방 근거?','2025년 업황 바닥 때 PBR이 0.8~1.0배였습니다. BPS 약 30만 9천원 기준으로 1배면 시총 25조원, 지금보다 11조원 낮습니다.'],
 ['전고체는?','고객과 물량이 공시되지 않아 목표 시총에 넣지 않았습니다. 양산과 고객이 확인되면 더하는 옵션입니다.'],
 ['어떻게 담고 언제 파나?','하루 거래대금이 3,500억원이라 펀드 1%는 하루면 됩니다. 변동성이 78%라 세 번에 나눠 담고, 분기 AMPC가 두 분기 연속 줄거나 소재 요건 미달이 확인되면 팝니다.'],
 ['11/24 하루 13.5% 오른 이유?','원인은 확인하지 못했습니다. 그래서 시총 기준으로 위아래를 계산했고, 급등 다음 날 추격하지 않고 나눠 담습니다.'],
 ['메자닌 하우스가 왜 대형주를?','기준은 위험 대비 기대수익입니다. 위로 20조원, 아래로 11조원이라 1.8 대 1이고, 하루에 사고팔 수 있어 비중 조절이 자유롭습니다.'],
 ['두 종목을 같이 들어도 되나?','1년 일간 수익률 상관계수가 0.21입니다. 펌텍은 소비, 삼성SDI는 전력 인프라라 서로 다른 이유로 움직입니다.']];
 H+=`<section class="page" id="qa"><div class="page-head"><h1>예상 질의</h1><p>눌러서 답 보기 · 금액은 시총 기준</p></div>${card('','',`<div class="qa">${QA.map(([q,a])=>`<details><summary>${q}</summary><p>${a}</p></details>`).join('')}</div>`)}</section>`;
 H+=`<section class="page" id="src"><div class="page-head"><h1>출처</h1></div>${card('','',`<ul class="def"><li>DART 삼성SDI 분기·사업보고서, 주요사항보고서(유상증자 2025.03.14, 삼성디스플레이 지분 양도 2026.08.21), 투자판단관련(GM JV 종료 2026.08.11, 미국 공급계약 2026.01.30), 장래사업계획(2026.07.02~03)</li><li>중국 배제: Utility Dive(2026.8·9, BNEF), POWER Magazine(EO 14421), Rystad Energy, Hunton, pv magazine(2026.6.10), ESS News(2026.8.27), Foley Hoag(2026.7), IRS Notice 2026-15, Fluence 10-K·AES 10-Q·Energy Vault 10-Q(SEC), SCMP, 그린포스트코리아, 코리아중앙데일리·머니투데이(2026.11.16)</li><li>KUVIC 리서치 2팀 「ESSential」(2026.09.14): 미국 ESS 수요, 중국 채택률, 45X·48E 원가, 3사 비교</li><li>S.R.S SOKHA 리서치팀 「삼성ESS, The Ideal Pick」(2026.11.10): 산업·ESS·UPS·BBU·전고체 추정과 SOTP</li><li>리포트: 교보(11/20)·SK·유안타·대신·하나(10/30) · 기사로 확인: 신한(11/4 이투데이, 10/30 브릿지경제, 10/14 파이낸셜포스트), DS(10/8)·iM(9/21) 파이낸셜뉴스, 삼성(9/28 아주경제)</li><li>주가·피어: Yahoo Finance(11/24)</li></ul>`)}</section>`;
 $('#main').innerHTML=H;
 {const N=[[2.0,'2.0조(-15%)'],[2.35,'2.35조(컨센)'],[2.76,'2.76조(대신)']],M=[15.4,20,24,28];$('#sens').innerHTML=`<thead><tr><th>순이익 ↓ / PER →</th>${M.map(m=>`<th class="n">${m}배</th>`).join('')}</tr></thead><tbody>${N.map(([n,l])=>`<tr><td>${l}</td>${M.map(m=>{const v=sensP(n,m);return `<td class="n ${cls(v-MC)}"${n===2.35&&m===24?' style="font-weight:800"':''}>${nf(v,1)} (${fa(add(v))})</td>`}).join('')}</tr>`).join('')}</tbody>`;}
 $('#foot').textContent='리서치 정리 · 투자 권유 아님';
 $('#stamp').textContent='기준 2026-11-24';
 ['vN','vP'].forEach(id=>document.getElementById(id).addEventListener('input',calc));calc();
}
function calc(){const v=+$('#vN').value*+$('#vP').value;$('#vOut').textContent=nf(v,1)+'조';const a=v-MC;$('#vUp').innerHTML=`지금 대비 <span class="${cls(a)}">${a>0?'+':''}${nf(a,1)}조 (${pc(a/MC*100)})</span>`}
function mk(id,cfg){const el=document.getElementById(id);if(!el)return;const old=Chart.getChart(el);if(old)old.destroy();Chart.defaults.color=css('--sub');Chart.defaults.borderColor=css('--grid');Chart.defaults.font.family='Pretendard Variable, Pretendard, sans-serif';new Chart(el,cfg)}
function draw(h){
 const c1=css('--c1'),c2=css('--c2'),c3=css('--c3'),c4=css('--c4'),c5=css('--c5'),c6=css('--c6');
 const O={responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{boxWidth:10}}}};
 const noL={...O,plugins:{legend:{display:false}}};
 if(h==='fin'){
  mk('cQ',{data:{labels:Q.map(r=>r.q),datasets:[{type:'bar',label:'매출(억)',data:Q.map(r=>r.rev),backgroundColor:c1+'aa',yAxisID:'y'},{type:'bar',label:'영업이익(억)',data:Q.map(r=>r.op),backgroundColor:Q.map(r=>r.op<0?css('--down'):c2),yAxisID:'y1'},{type:'line',label:'OPM(%)',data:Q.map(r=>+(r.op/r.rev*100).toFixed(1)),borderColor:c5,yAxisID:'y2',tension:.3}]},options:{...O,scales:{y:{beginAtZero:true},y1:{display:false},y2:{position:'right',grid:{display:false},ticks:{callback:v=>v+'%'}}}}});
  mk('cY',{data:{labels:Y.map(r=>r.y),datasets:[{type:'bar',label:'영업이익 AMPC 포함(억)',data:Y.map(r=>r.op),backgroundColor:Y.map(r=>r.op<0?css('--down'):r.e?c1+'88':c1)},{type:'line',label:'AMPC 외 영업이익',data:Y.map(r=>r.ex??null),borderColor:c5,borderDash:[5,4],spanGaps:true},{type:'line',label:'증권사 평균',data:Y.map(r=>r.c??null),borderColor:c3,showLine:false,pointRadius:6,pointStyle:'rectRot'}]},options:O});
 }
 if(h==='ess'){
  mk('cCapa',{type:'bar',data:{labels:CAPA.y,datasets:[{label:'미국 ESS CAPA',data:CAPA.v,backgroundColor:CAPA.y.map(y=>y.includes('E')?c3+'99':c3)},{type:'line',label:'미국 판매량',data:ESS.q,borderColor:c2}]},options:O});
  mk('cEss',{type:'bar',data:{labels:ESS.y,datasets:[{label:'미국 생산',data:ESS.us,backgroundColor:c1},{label:'미국 외',data:ESS.nus,backgroundColor:c6+'99'}]},options:{...O,scales:{x:{stacked:true},y:{stacked:true}}}});
 }
 if(h==='china') mk('cCn',{type:'bar',data:{labels:['2026','2027E','2028E','2029E'],datasets:[{label:'중국 셀 채택률(%)',data:[71.2,39.8,3.9,0],backgroundColor:[css('--up'),css('--up')+'bb',css('--up')+'77',css('--up')+'44']}]},options:{...noL,scales:{y:{max:100,ticks:{callback:v=>v+'%'}}}}});
 if(h==='ups') mk('cUB',{type:'bar',data:{labels:UB.y,datasets:[{label:'UPS',data:UB.ups,backgroundColor:c1},{label:'BBU',data:UB.bbu,backgroundColor:c2}]},options:{...O,scales:{x:{stacked:true},y:{stacked:true}}}});
 if(h==='ampc') mk('cAm',{type:'bar',data:{labels:AMPCY.y,datasets:[{label:'AMPC',data:AMPCY.a,backgroundColor:[c6,c1,c3]}]},options:{...noL,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>nf(c.raw,2)+'조'}}}}});
 if(h==='val'){const L=['하방','지금','보수 20배','목표 24배','증권사 평균','참고: SOKHA'],V=[SC.down,MC,SC.c20,SC.tgt,SC.avg6,SC.sk];mk('cV',{type:'bar',data:{labels:L,datasets:[{data:V,backgroundColor:[css('--down'),c6,c3,c1,c2,c6+'66']}]},options:{...noL,indexAxis:'y',plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>nf(c.raw,1)+'조 ('+fa(add(c.raw))+')'}}}}})}
 if(h==='px'){
  mk('cP',{type:'line',data:{labels:P.d,datasets:[{label:'삼성SDI',data:P['삼성SDI'],borderColor:c1,pointRadius:0,borderWidth:1.6,spanGaps:true}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{maxTicksLimit:8}}}}});
  const base=a=>{const f=a.find(x=>x!=null);return a.map(x=>x==null?null:+(x/f*100).toFixed(1))};
  const cs=[c1,c2,c3,c4,c5,c6];
  mk('cR',{type:'line',data:{labels:P.d,datasets:['삼성SDI','LG에너지솔루션','SK이노베이션','CATL','파나소닉','포스코퓨처엠'].map((n,i)=>({label:n,data:base(P[n]),borderColor:cs[i],pointRadius:0,borderWidth:n==='삼성SDI'?2.4:1.2,spanGaps:true}))},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{boxWidth:10}}},scales:{x:{ticks:{maxTicksLimit:8}}}}});
 }
}
$('#theme').onclick=()=>{const r=document.documentElement;const cur=r.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');r.dataset.theme=cur==='dark'?'light':'dark';nav()};
build();window.addEventListener('hashchange',nav);nav();
</script>
</body>
</html>
