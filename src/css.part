<style>
:root{--bg:#f4f5f7;--card:#fff;--text:#191f28;--sub:#4e5968;--muted:#8b95a1;--line:#e9ebee;--chip:#f2f4f6;--chip-on:#fff;--up:#d6453d;--down:#3a6fd8;--accent:#3182f6;--hover:#f7f8fa;--head-bg:rgba(255,255,255,.86);--shadow:0 1px 2px rgba(16,24,40,.04),0 4px 16px rgba(16,24,40,.05);--grid:#eef0f3;
--c1:#3182f6;--c2:#f59e0b;--c3:#14a39a;--c4:#9b6bd3;--c5:#d6453d;--c6:#8b95a1;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#101216;--card:#191c22;--text:#e8eaed;--sub:#b0b8c1;--muted:#7d8590;--line:#2a2e36;--chip:#242832;--chip-on:#343a46;--up:#ff7a72;--down:#6f9bff;--accent:#4b93ff;--hover:#20242c;--head-bg:rgba(25,28,34,.86);--shadow:none;--grid:#242832;--c1:#4b93ff;--c2:#f5b342;--c3:#2fc4b8;--c4:#b48ae8;--c5:#ff7a72;--c6:#7d8590;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#101216;--card:#191c22;--text:#e8eaed;--sub:#b0b8c1;--muted:#7d8590;--line:#2a2e36;--chip:#242832;--chip-on:#343a46;--up:#ff7a72;--down:#6f9bff;--accent:#4b93ff;--hover:#20242c;--head-bg:rgba(25,28,34,.86);--shadow:none;--grid:#242832;--c1:#4b93ff;--c2:#f5b342;--c3:#2fc4b8;--c4:#b48ae8;--c5:#ff7a72;--c6:#7d8590;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 "Pretendard Variable",Pretendard,-apple-system,"Apple SD Gothic Neo",sans-serif;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
a{color:inherit}button,select,input{font:inherit;color:inherit}
.top{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:20px;padding:10px 32px;background:var(--head-bg);border-bottom:1px solid var(--line);-webkit-backdrop-filter:saturate(1.6) blur(12px);backdrop-filter:saturate(1.6) blur(12px)}
.brand{font-weight:800;font-size:16px;white-space:nowrap;display:flex;align-items:center;gap:8px}
.brand::before{content:"";width:22px;height:22px;border-radius:7px;background:linear-gradient(135deg,var(--up),#f59e0b 55%,var(--accent))}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none}.tabs::-webkit-scrollbar{display:none}
.tab{padding:6px 12px;border-radius:999px;white-space:nowrap;color:var(--sub);text-decoration:none;cursor:pointer;border:0;background:none;min-height:34px}
.tab:hover{background:var(--chip);color:var(--text)}.tab.on{background:var(--text);color:var(--card);font-weight:600}
.top-right{margin-left:auto;display:flex;gap:8px;align-items:center;color:var(--muted);font-size:12px;white-space:nowrap}
.icon-btn{background:var(--card);border:1px solid var(--line);border-radius:8px;width:34px;height:34px;cursor:pointer}
main{max-width:1240px;margin:0 auto;padding:18px 32px 40px}
.page{display:none}.page.on{display:block}
.page-head{margin:6px 2px 14px}.page-head h1{margin:0 0 2px;font-size:22px;font-weight:800;letter-spacing:-.03em}.page-head p{margin:0;color:var(--muted);font-size:13px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:16px 20px;margin-bottom:14px}
.card h2{margin:0 0 4px;font-size:16px;font-weight:700}.cap{color:var(--muted);font-size:12.5px;margin:0 0 10px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-bottom:14px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 14px;box-shadow:var(--shadow);cursor:pointer;text-align:left}
.kpi:hover{background:var(--hover)}.kpi .l{font-size:12px;color:var(--muted)}.kpi .v{font-size:22px;font-weight:800;letter-spacing:-.02em}.kpi .s{font-size:12px;color:var(--sub)}
.up{color:var(--up)}.down{color:var(--down)}.muted{color:var(--muted)}
.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:10px 12px;margin-bottom:12px;box-shadow:var(--shadow)}
.seg{display:inline-flex;background:var(--chip);border-radius:10px;padding:3px;flex-wrap:wrap}
.seg button{border:0;background:none;padding:5px 11px;border-radius:8px;cursor:pointer;color:var(--sub);white-space:nowrap;min-height:32px}
.seg button.on{background:var(--chip-on);color:var(--text);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.dir{border:1px solid var(--line);background:var(--card);border-radius:8px;padding:5px 12px;cursor:pointer;min-height:34px;font-weight:600}
.lbl{font-size:12px;color:var(--muted);margin-right:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:12px}
.wc{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:var(--shadow);display:flex;flex-direction:column;text-decoration:none;color:inherit}
.wc:hover{border-color:var(--sub)}
.wc .im{position:relative;aspect-ratio:3/4;background:var(--chip);overflow:hidden}
.wc .im img{width:100%;height:100%;object-fit:cover;display:block}
.wc .rk{position:absolute;left:8px;top:8px;background:rgba(0,0,0,.72);color:#fff;font-weight:800;font-size:13px;border-radius:8px;padding:2px 8px}
.wc .ch{position:absolute;right:8px;top:8px;font-size:11px;font-weight:700;border-radius:8px;padding:2px 6px;background:rgba(255,255,255,.92);color:#191f28}
.wc .bd{padding:10px 12px;display:flex;flex-direction:column;gap:4px}
.wc .t{font-weight:700;font-size:13.5px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:36px}
.wc .g{font-size:11px;color:var(--muted)}
.wc .m{display:grid;grid-template-columns:1fr auto;gap:1px 8px;font-size:12px}.wc .m span:nth-child(odd){color:var(--muted)}.wc .m b{text-align:right}
.chip{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:8px;background:var(--chip);margin-right:4px}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:7px 8px;border-top:1px solid var(--line);text-align:left;white-space:nowrap}
th{font-size:12px;font-weight:600;color:var(--muted);background:var(--hover);border-top:0;cursor:pointer;user-select:none}
th.on{color:var(--accent)}th.on[data-dir=desc]::after{content:" ▼";font-size:10px}th.on[data-dir=asc]::after{content:" ▲";font-size:10px}
td.n,th.n{text-align:right}tbody tr:hover{background:var(--hover)}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px}
.ch-box{position:relative;height:280px}.ch-box.tall{height:340px}
.fin-in{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px 14px;margin-bottom:12px}
.fin-in label{font-size:12px;color:var(--sub);display:flex;flex-direction:column;gap:3px}
input[type=number]{padding:6px 8px;border:1px solid var(--line);border-radius:8px;background:var(--bg);min-height:36px;width:100%}
.ct input{max-width:110px;text-align:right}td.d{color:var(--muted);font-size:12px;white-space:normal;min-width:180px}
.note{background:var(--chip);border-radius:10px;padding:10px 12px;font-size:13px;margin-bottom:12px}
.bad{background:rgba(214,69,61,.08);border:1px solid rgba(214,69,61,.25)}
ul.def{margin:0;padding-left:18px}ul.def li{margin:4px 0}
footer{max-width:1240px;margin:0 auto;padding:0 32px 40px;color:var(--muted);font-size:12px}
@media (max-width:720px){.top{padding:8px 12px;gap:10px;flex-wrap:wrap}.top-right{display:none}main{padding:12px 12px 32px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two{grid-template-columns:1fr}footer{padding:0 12px 32px}}
</style>